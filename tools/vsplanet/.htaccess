# books.vsplanet.net — статический сайт (без PHP и базы данных)
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/epub+zip      .epub
  AddType font/woff2                .woff2
  AddType image/webp                .webp
  AddType image/svg+xml             .svg
  AddCharset utf-8 .html .css .js .json .txt .xml .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # только https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://books.vsplanet.net%{REQUEST_URI} [R=301,L]
  # один адрес у каждой страницы: /книга/index.html → /книга/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # старый адрес полки
  RewriteRule ^shelf/?$ / [R=301,L]
</IfModule>

# сжатие: Brotli, если модуль есть, иначе gzip
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # сайт грузит ресурсы только со своего домена; встраивать его в рамку может только VSplanet
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://vsplanet.net https://*.vsplanet.net"

  # по умолчанию (страницы, sitemap, манифест) — всегда сверять с сервером
  Header set Cache-Control "no-cache"
  # файлы с хэшем в имени, шрифты и тексты глав — навсегда
  <FilesMatch "(-[0-9a-f]{8,12}\.(js|css|json|epub|txt|woff2))$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # картинки — 30 дней
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # должны обновляться сразу
  <FilesMatch "^(sw\.js|pwa\.js|files\.json|version\.json|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
