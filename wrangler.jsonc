{
  "name": "andreev",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mave/api/*", "/ubweb", "/ubweb/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "UBWEB_REVIEW", "class_name": "UbwebReview" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UbwebReview"] }]
}
